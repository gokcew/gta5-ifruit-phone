<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#080B14"
                android:centerColor="#0A0E1C"
                android:endColor="#060810"
                android:angle="270"/>
        </shape>
    </item>
    <!-- Subtle top highlight -->
    <item android:bottom="90%">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#15A3FF47"
                android:endColor="#00A3FF47"
                android:angle="270"/>
        </shape>
    </item>
</layer-list>
