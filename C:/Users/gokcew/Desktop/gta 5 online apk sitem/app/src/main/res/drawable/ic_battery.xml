<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Battery outline -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#A3FF47"/>
            <corners android:radius="2dp"/>
            <size android:width="22dp" android:height="12dp"/>
        </shape>
    </item>
    <!-- Battery fill (75%) -->
    <item android:right="6dp" android:top="2dp" android:bottom="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#A3FF47"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <!-- Battery tip -->
    <item android:left="22dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#A3FF47"/>
            <size android:width="2dp"/>
        </shape>
    </item>
</layer-list>
