<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B14">

    <!-- Big avatar circle -->
    <TextView
        android:id="@+id/tvCallInitial"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:gravity="center"
        android:text="L"
        android:textColor="#A3FF47"
        android:textSize="48sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:background="@drawable/circle_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVerticalBias="0.22"/>

    <!-- Contact Name -->
    <TextView
        android:id="@+id/tvCallName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lester Crest"
        android:textColor="@color/gta_white"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        app:layout_constraintTop_toBottomOf="@id/tvCallInitial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <!-- Number -->
    <TextView
        android:id="@+id/tvCallNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(555) 372-3767"
        android:textColor="#888888"
        android:textSize="14sp"
        android:fontFamily="sans-serif-condensed"
        app:layout_constraintTop_toBottomOf="@id/tvCallName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"/>

    <!-- Calling status -->
    <TextView
        android:id="@+id/tvCallStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CALLING..."
        android:textColor="#A3FF47"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:fontFamily="sans-serif-condensed"
        app:layout_constraintTop_toBottomOf="@id/tvCallNumber"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Timer -->
    <TextView
        android:id="@+id/tvCallTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="#CCCCCC"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-light"
        app:layout_constraintTop_toBottomOf="@id/tvCallStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:visibility="gone"/>

    <!-- Action buttons row -->
    <LinearLayout
        android:id="@+id/callActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toTopOf="@id/endCallBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp">

        <!-- Mute -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="🔇"
                android:textSize="22sp"
                android:background="@drawable/circle_btn_dark"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mute"
                android:textColor="#888888"
                android:textSize="10sp"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-condensed"/>
        </LinearLayout>

        <!-- Speaker -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="🔊"
                android:textSize="22sp"
                android:background="@drawable/circle_btn_dark"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speaker"
                android:textColor="#888888"
                android:textSize="10sp"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-condensed"/>
        </LinearLayout>

        <!-- Keypad -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="⌨"
                android:textSize="22sp"
                android:background="@drawable/circle_btn_dark"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keypad"
                android:textColor="#888888"
                android:textSize="10sp"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-condensed"/>
        </LinearLayout>

    </LinearLayout>

    <!-- END CALL Button -->
    <TextView
        android:id="@+id/endCallBtn"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:gravity="center"
        android:text="📵"
        android:textSize="28sp"
        android:background="@drawable/circle_red"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="END"
        android:textColor="#FF4444"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/endCallBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
