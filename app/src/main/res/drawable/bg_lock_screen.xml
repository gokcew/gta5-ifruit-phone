<?xml version="1.0" encoding="utf-8"?>
<!-- GTA 5 Lock Screen Background - dark cityscape gradient -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0A0E1A"
                android:centerColor="#0D1520"
                android:endColor="#050810"
                android:angle="270" />
        </shape>
    </item>
    <!-- Subtle city lights glow at bottom -->
    <item android:top="60%">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00000000"
                android:endColor="#1A3A5C"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
