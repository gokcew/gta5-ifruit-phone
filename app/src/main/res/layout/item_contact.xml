<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@drawable/bg_contact_row"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar circle with initial -->
    <TextView
        android:id="@+id/tvInitial"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:background="@drawable/circle_avatar"
        android:textColor="#A3FF47"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:text="L"
        android:layout_marginEnd="14dp"/>

    <!-- Name + number -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lester Crest"
            android:textColor="@color/gta_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"/>

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(555) 372-3767"
            android:textColor="#888888"
            android:textSize="12sp"
            android:fontFamily="sans-serif-condensed"/>
    </LinearLayout>

    <!-- Call icon -->
    <TextView
        android:id="@+id/btnCallContact"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="📞"
        android:textSize="16sp"
        android:background="@drawable/circle_green"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Divider -->
</LinearLayout>
