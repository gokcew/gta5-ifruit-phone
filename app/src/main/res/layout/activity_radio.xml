<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B14">

    <!-- Status Bar -->
    <include layout="@layout/include_status_bar"
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Title -->
    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_title_bar"
        app:layout_constraintTop_toBottomOf="@id/statusBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎵"
            android:textSize="18sp"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RADIO"
            android:textColor="#A3FF47"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-condensed"/>
    </LinearLayout>

    <!-- Now Playing Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/nowPlayingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#0D1B0D"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/titleBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOW PLAYING"
                android:textColor="#A3FF47"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Station art placeholder -->
                <TextView
                    android:id="@+id/tvStationArt"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:text="📻"
                    android:textSize="30sp"
                    android:background="@drawable/station_art_bg"
                    android:layout_marginEnd="14dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStationName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Los Santos Rock Radio"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"/>

                    <TextView
                        android:id="@+id/tvTrackName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Don't Stop Me Now - Queen"
                        android:textColor="#A3FF47"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-condensed"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvFrequency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="107.7 FM"
                        android:textColor="#555555"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-condensed"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Progress bar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="#1A1A1A"
                android:layout_marginTop="12dp"/>
            <View
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:background="#A3FF47"
                android:layout_marginTop="-3dp"/>

            <!-- Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <TextView android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:gravity="center"
                    android:text="⏮" android:textColor="#CCCCCC" android:textSize="22sp"
                    android:clickable="true" android:focusable="true"/>

                <TextView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:text="⏸"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:background="@drawable/circle_green"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:gravity="center"
                    android:text="⏭" android:textColor="#CCCCCC" android:textSize="22sp"
                    android:id="@+id/btnNext"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Radio Stations list -->
    <TextView
        android:id="@+id/stationsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ALL STATIONS"
        android:textColor="#555555"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:fontFamily="sans-serif-condensed"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingCard"
        app:layout_constraintStart_toStartOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/stationsLabel"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/stationsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"/>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
