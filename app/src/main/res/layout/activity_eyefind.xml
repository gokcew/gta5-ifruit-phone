<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0EDE8">

    <!-- Status Bar (dark) -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:background="#333333"
        app:layout_constraintTop_toTopOf="parent">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Gruppe Sechs"
            android:textColor="#A3FF47" android:textSize="10sp" android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="12:00" android:textColor="#FFFFFF" android:textSize="10sp"
            android:textStyle="bold" android:layout_marginEnd="8dp"/>
        <ImageView android:layout_width="16dp" android:layout_height="12dp"
            android:src="@drawable/ic_signal_bars" android:layout_marginEnd="4dp"/>
        <ImageView android:layout_width="22dp" android:layout_height="12dp"
            android:src="@drawable/ic_battery"/>
    </LinearLayout>

    <!-- Browser chrome top bar -->
    <LinearLayout
        android:id="@+id/browserBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/statusBar">

        <!-- Back / Forward -->
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:gravity="center" android:text="◀" android:textColor="#999999"
            android:textSize="16sp" android:layout_marginEnd="4dp"/>
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:gravity="center" android:text="▶" android:textColor="#CCCCCC"
            android:textSize="16sp" android:layout_marginEnd="6dp"/>

        <!-- URL bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/url_bar_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔒" android:textSize="11sp" android:layout_marginEnd="6dp"/>
            <TextView
                android:id="@+id/tvUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="eyefind.com"
                android:textColor="#333333"
                android:textSize="13sp"
                android:fontFamily="sans-serif-condensed"/>
        </LinearLayout>

        <!-- Reload -->
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:gravity="center" android:text="↻" android:textColor="#E65100"
            android:textSize="20sp" android:layout_marginStart="6dp"/>

        <!-- Menu -->
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:gravity="center" android:text="⋮" android:textColor="#666666"
            android:textSize="20sp"/>
    </LinearLayout>

    <!-- eyefind homepage content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:background="#F0EDE8"
        app:layout_constraintTop_toBottomOf="@id/browserBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- eyefind logo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="eye" android:textColor="#E65100"
                    android:textSize="42sp" android:textStyle="bold"
                    android:fontFamily="serif"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="find" android:textColor="#333333"
                    android:textSize="42sp" android:textStyle="bold"
                    android:fontFamily="serif"/>
            </LinearLayout>

            <!-- Search bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/search_bar_bg"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:elevation="2dp">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Search the internet..."
                    android:textColor="#999999"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-condensed"/>

                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="🔍"
                    android:textSize="18sp"
                    android:background="@drawable/circle_eyefind"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>

            <!-- Quick links -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout style="@style/QuickLink" android:layout_marginEnd="12dp">
                    <TextView android:layout_width="44dp" android:layout_height="44dp"
                        android:gravity="center" android:text="🏦" android:textSize="20sp"
                        android:background="@drawable/quicklink_bg"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Maze Bank" android:textColor="#555555"
                        android:textSize="10sp" android:fontFamily="sans-serif-condensed"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout style="@style/QuickLink" android:layout_marginEnd="12dp">
                    <TextView android:layout_width="44dp" android:layout_height="44dp"
                        android:gravity="center" android:text="📰" android:textSize="20sp"
                        android:background="@drawable/quicklink_bg"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LS News" android:textColor="#555555"
                        android:textSize="10sp" android:fontFamily="sans-serif-condensed"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout style="@style/QuickLink" android:layout_marginEnd="12dp">
                    <TextView android:layout_width="44dp" android:layout_height="44dp"
                        android:gravity="center" android:text="🚗" android:textSize="20sp"
                        android:background="@drawable/quicklink_bg"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Legendarymotorsport" android:textColor="#555555"
                        android:textSize="10sp" android:fontFamily="sans-serif-condensed"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout style="@style/QuickLink">
                    <TextView android:layout_width="44dp" android:layout_height="44dp"
                        android:gravity="center" android:text="🔫" android:textSize="20sp"
                        android:background="@drawable/quicklink_bg"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ammu-Nation" android:textColor="#555555"
                        android:textSize="10sp" android:fontFamily="sans-serif-condensed"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#DDDDDD" android:layout_marginTop="20dp"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

            <!-- News headlines -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOP STORIES"
                android:textColor="#E65100"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-condensed"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:layout_marginTop="8dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• Police Baffled By String Of Armored Car Robberies In Vinewood"
                    android:textColor="#333333" android:textSize="13sp"
                    android:fontFamily="sans-serif-condensed" android:paddingBottom="8dp"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• Maze Bank Reports Record Profits Despite LS Violence"
                    android:textColor="#333333" android:textSize="13sp"
                    android:fontFamily="sans-serif-condensed" android:paddingBottom="8dp"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• New Military Hardware Spotted At Fort Zancudo"
                    android:textColor="#333333" android:textSize="13sp"
                    android:fontFamily="sans-serif-condensed" android:paddingBottom="8dp"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• Merryweather Security Denies Using Citizens As Test Subjects"
                    android:textColor="#333333" android:textSize="13sp"
                    android:fontFamily="sans-serif-condensed" android:paddingBottom="8dp"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• Weazel News: LifeInvader CEO To Address Stock Concerns"
                    android:textColor="#333333" android:textSize="13sp"
                    android:fontFamily="sans-serif-condensed" android:paddingBottom="8dp"/>
            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="eyefind.com — You can find it if you can see it™"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:gravity="center"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginTop="24dp"/>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
